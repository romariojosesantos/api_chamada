{
  "version": 2,
  "installCommand": "npm install",
  "regions": ["gru1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{assets/**,node_modules/pdfkit/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/lembrete-chamada",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/saude-banco",
      "schedule": "0 13 * * *"
    }
  ]
}

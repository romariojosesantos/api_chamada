	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{authToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Adiciona o header x-institution-id em todas as requisições, exceto as de autenticação.",
					"const isAuthRequest = pm.request.url.path.join('/').startsWith('api/auth');",
					"",
					"if (!isAuthRequest) {",
					"    pm.request.headers.add({",
					"        key: 'x-institution-id',",
					"        value: pm.collectionVariables.get('institutionId')",
					"    });",
					"}"
				]
			}
		},
		{

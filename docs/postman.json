	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
		"name": "Controle de Presença API",
		"description": "Coleção para testar a API de Controle de Presença. A autenticação e o ID da instituição são gerenciados automaticamente após o login.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "POST Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"authToken\", jsonData.token);",
									"    console.log(\"Token de autenticação salvo.\");",
									"}",
									"",
									"if (jsonData.user && jsonData.user.instituicoes && jsonData.user.instituicoes.length > 0) {",
									"    pm.collectionVariables.set(\"institutionId\", jsonData.user.instituicoes[0]);",
									"    console.log(\"ID da Instituição salvo: \", jsonData.user.instituicoes[0]);",
									"} else if (jsonData.user && jsonData.user.perfil === 'master') {",
									"    console.log(\"Usuário é master. O ID da instituição precisa ser definido manualmente para rotas específicas.\");",
									"    // Para master, talvez seja necessário setar um ID padrão ou deixar em branco",
									"    pm.collectionVariables.set(\"institutionId\", \"1\"); // Defina um ID padrão se necessário",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"master@exemplo.com\",\n    \"senha\": \"senha123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Realiza o login e salva o token e o ID da instituição automaticamente para serem usados nas outras requisições."
					},
					"response": []
				},
